# Roadway Logistics Group LLC - Backend Environment Variables
# Copy this to .env and fill in your real values

PORT=5000
NODE_ENV=development

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Email (Nodemailer) - use Gmail App Password or SMTP service
# For development, leave blank to use Ethereal (auto preview in console)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Who to notify on new submissions
NOTIFY_EMAIL=info@roadwaylogisticsgroup.com

# Company phone (for auto-reply content)
COMPANY_PHONE=+1-682-978-8641
COMPANY_NAME=Roadway Logistics Group LLC
